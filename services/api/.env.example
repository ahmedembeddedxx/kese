# Copy to .env for local development. Never commit a real .env.
MEND_ENVIRONMENT=development

# Gemini API key (AI Studio). Leave unset to run with all Gemini calls
# failing closed (clear 503s) -- useful for testing everything except the
# live model calls without a key.
MEND_GEMINI_API_KEY=

# Replicate API token, for the SAM segmentation fallback.
MEND_REPLICATE_API_TOKEN=

# Leave unset locally; docker-compose sets this to the Firestore emulator.
MEND_FIRESTORE_EMULATOR_HOST=
MEND_FIREBASE_PROJECT_ID=demo-mend

MEND_CORS_ORIGINS=["http://localhost:5173"]

# ElevenLabs API key and voice id (Urdu STT via Scribe v2 Realtime, TTS via
# eleven_v4_turbo). If either is unset, /session falls back to Gemini native
# audio automatically.
MEND_ELEVENLABS_API_KEY=
MEND_ELEVENLABS_VOICE_ID=

# Run with deterministic fake Gemini/Replicate/ElevenLabs clients, no keys
# needed. Refused at startup when MEND_ENVIRONMENT=production.
MEND_DEV_FAKES=false

# Per-user rate limit for POST /voice/token.
MEND_VOICE_TOKEN_RATE_LIMIT=30/minute

# Per-user rate limit for GET /options (settings sheet: voices and models).
MEND_OPTIONS_RATE_LIMIT=30/minute

# Extra selectable models, comma separated ids (label = id), appended to the
# built-in lists so the team can add models without a code change. Every TTS
# model added here must support Urdu. Example: MEND_TTS_MODEL_OPTIONS_EXTRA=eleven_v4
MEND_LIVE_MODEL_OPTIONS_EXTRA=
MEND_TTS_MODEL_OPTIONS_EXTRA=
