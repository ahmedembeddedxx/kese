rules_version = '2';

// Mend Firestore security rules.
//
// The FastAPI backend writes through the Firebase Admin SDK, which
// bypasses these rules entirely -- they exist to guarantee that even if a
// client somehow talked to Firestore directly (it never should; the app
// only ever goes through our API), a user could still only ever read or
// write their own data. Per AGENTS.md: "check Firestore security rules
// so users only read their own data, plan devices and pins."
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // users/{uid} and users/{uid}/devices/{deviceId}: a user may only
    // read or write their own subtree.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /devices/{deviceId} {
        allow read, write: if isOwner(uid);
      }
    }

    // events/{eventId}: a user may create their own event logs, never
    // read or modify anyone's (these are write-mostly analytics; reading
    // them back goes through the backend, not direct Firestore access).
    match /events/{eventId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // kb_chunks/{chunkId}: knowledge-base content is public read (it's
    // shown in-app with citations), written only by the crawl pipeline's
    // service account via the Admin SDK, never by end users.
    match /kb_chunks/{chunkId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
