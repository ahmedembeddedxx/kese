{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mend.app/playbook.schema.json",
  "title": "Mend playbook",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "category", "title", "title_ur", "summary", "summary_ur", "risk", "tools", "tools_ur", "steps", "stop_if", "stop_if_ur", "sources", "review"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64},
    "category": {"enum": ["electrical", "ac", "car"]},
    "title": {"type": "string", "minLength": 3, "maxLength": 80},
    "title_ur": {"type": "string", "minLength": 2, "maxLength": 80},
    "summary": {"type": "string", "minLength": 10, "maxLength": 240},
    "summary_ur": {"type": "string", "minLength": 5, "maxLength": 240},
    "risk": {"enum": ["low", "medium", "high"]},
    "tools": {"type": "array", "items": {"type": "string", "minLength": 2, "maxLength": 80}, "maxItems": 12},
    "tools_ur": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 80}, "maxItems": 12},
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "say", "say_ur"],
        "properties": {
          "id": {"type": "string", "pattern": "^s[0-9]{1,2}$"},
          "say": {"type": "string", "minLength": 5, "maxLength": 400},
          "say_ur": {"type": "string", "minLength": 3, "maxLength": 400},
          "gate": {"type": "string", "pattern": "^[a-z_]+$"},
          "highlight": {"type": "array", "items": {"type": "string", "minLength": 2, "maxLength": 60}, "maxItems": 4},
          "read_text": {"type": "boolean"},
          "mark_wires": {"type": "boolean"}
        }
      }
    },
    "stop_if": {"type": "array", "items": {"type": "string", "minLength": 3, "maxLength": 120}, "maxItems": 10},
    "stop_if_ur": {"type": "array", "items": {"type": "string", "minLength": 2, "maxLength": 120}, "maxItems": 10},
    "sources": {"type": "array", "items": {"type": "string", "pattern": "^(kb|seed):[A-Za-z0-9._-]+$"}, "maxItems": 12},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safety_reviewed", "reviewed_by", "reviewed_on"],
      "properties": {
        "safety_reviewed": {"type": "boolean"},
        "reviewed_by": {"type": ["string", "null"]},
        "reviewed_on": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    }
  }
}
